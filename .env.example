# Downloader configuration. Keep real credentials in the ignored .env.
# Replace these locally. Do not commit credentials.
TUSHARE_TOKEN=
PGHOST=localhost
PGPORT=5432
PGDATABASE=tushare
PGUSER=tushare_writer
PGPASSWORD=
PGSSLMODE=prefer
LOG_DIR=./logs
REPORT_DIR=./reports
LOG_LEVEL=INFO
PROGRESS=auto
PLAIN=false
PROGRESS_INTERVAL_SECONDS=5
REPORT_MAX_ITEMS=20
MAX_AGE=24h
LOOKBACK_DAYS=7
EMPTY_RECHECK_AGE=24h
MAX_ATTEMPTS=4
REQUESTS_PER_MINUTE=60
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=60
RETRY_MAX_SECONDS=60
MAX_RESPONSE_BYTES=33554432
MAX_CONSECUTIVE_FAILED_SLICES=10
# Integration tests must use a dedicated database when implemented.
TEST_DATABASE_URL=
